---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { AGENTS, BROKERAGE, SITE } from '../../lib/constants';
import {
  STATUS_META,
  formatNumber,
  formatPrice,
  fullAddress,
  mapUrl,
  type ListingStatus,
} from '../../lib/listings';

export async function getStaticPaths() {
  const listings = await getCollection('listings', l => !l.data.draft);
  return listings.map(listing => ({ params: { slug: listing.id }, props: { listing } }));
}

const { listing } = Astro.props;
const { Content } = await render(listing);
const d = listing.data;

const status = STATUS_META[d.status as ListingStatus];
const address = fullAddress(d);
const agent = AGENTS.find(a => a.slug === d.agent) ?? AGENTS[0];
const pageUrl = `${SITE.url}/listings/${listing.id}`;

const stats = [
  { label: 'Bedrooms', value: formatNumber(d.beds) },
  { label: 'Bathrooms', value: formatNumber(d.baths) },
  d.sqft ? { label: 'Finished Sq Ft', value: formatNumber(d.sqft) } : null,
  d.acres ? { label: 'Acres', value: String(d.acres) } : null,
  d.yearBuilt ? { label: 'Year Built', value: String(d.yearBuilt) } : null,
].filter(Boolean) as { label: string; value: string }[];

const facts = [
  { label: 'Property Type', value: d.propertyType },
  d.yearBuilt ? { label: 'Year Built', value: String(d.yearBuilt) } : null,
  d.sqft ? { label: 'Finished Sq Ft', value: formatNumber(d.sqft) } : null,
  d.acres ? { label: 'Lot Size', value: `${d.acres} acres` } : null,
  { label: 'Bedrooms', value: formatNumber(d.beds) },
  { label: 'Bathrooms', value: formatNumber(d.baths) },
  d.county ? { label: 'County', value: `${d.county} County, MN` } : null,
  d.mls ? { label: 'MLS #', value: d.mls } : null,
].filter(Boolean) as { label: string; value: string }[];

const emailSubject = encodeURIComponent(`${d.address}, ${d.city} MN`);

const listingSchema = {
  '@type': 'RealEstateListing',
  '@id': `${pageUrl}/#listing`,
  url: pageUrl,
  name: `${address} — ${formatPrice(d.price)}`,
  description: d.description,
  datePosted: d.listDate.toISOString(),
  image: d.heroImage,
  offers: {
    '@type': 'Offer',
    price: d.price,
    priceCurrency: 'USD',
    availability:
      d.status === 'sold'
        ? 'https://schema.org/SoldOut'
        : 'https://schema.org/InStock',
    seller: { '@id': `${SITE.url}/#brokerage` },
  },
  about: {
    '@type': 'SingleFamilyResidence',
    name: address,
    numberOfRooms: d.beds,
    numberOfBathroomsTotal: d.baths,
    ...(d.yearBuilt ? { yearBuilt: d.yearBuilt } : {}),
    ...(d.sqft
      ? { floorSize: { '@type': 'QuantitativeValue', value: d.sqft, unitCode: 'FTK' } }
      : {}),
    ...(d.acres
      ? { lotSize: { '@type': 'QuantitativeValue', value: d.acres, unitText: 'acres' } }
      : {}),
    address: {
      '@type': 'PostalAddress',
      streetAddress: d.address,
      addressLocality: d.city,
      addressRegion: d.state,
      postalCode: d.zip,
      addressCountry: 'US',
    },
  },
  provider: { '@id': `${SITE.url}/agents/${agent.slug}/#agent` },
};

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Listings', item: `${SITE.url}/listings` },
    { '@type': 'ListItem', position: 3, name: address, item: pageUrl },
  ],
};
---

<Layout
  title={`${d.address}, ${d.city} MN — ${formatPrice(d.price)}`}
  description={d.description}
  image={d.heroImage}
  schema={[listingSchema, breadcrumbSchema]}
  type="article"
>
  <!-- Photo Hero -->
  <section class="relative min-h-[460px] md:min-h-[560px] overflow-hidden flex items-end">
    <img
      src={d.heroImage}
      alt={address}
      class="absolute inset-0 w-full h-full object-cover"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-[#1e3a5f]/55 via-[#1e3a5f]/40 to-[#1e3a5f]/85"></div>

    <div class="relative w-full">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 w-full pt-32 md:pt-40 pb-10">
        <a href="/listings" class="inline-flex items-center gap-1.5 text-sm text-white/60 hover:text-white transition-colors mb-5">
          <span aria-hidden="true">←</span> All Listings
        </a>

        <div class="flex items-center gap-3 mb-3">
          <span class={`text-xs font-bold uppercase tracking-widest px-2.5 py-1 rounded ${status.badge}`}>
            {status.label}
          </span>
          {d.mls && <span class="text-xs text-white/50 font-semibold tracking-wide">MLS #{d.mls}</span>}
        </div>

        <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-2 tracking-tight">{d.tagline}</h1>
        <p class="text-lg md:text-xl text-white/80">{address}</p>
        <p class="text-3xl md:text-4xl font-extrabold text-[#c9973a] mt-3">{formatPrice(d.price)}</p>

        <div class="grid sm:flex sm:flex-wrap gap-3 mt-6">
          <a href="#inquire" class="bg-[#c9973a] text-white px-6 py-3 rounded-lg text-sm font-bold hover:bg-[#b8832e] transition-colors text-center">
            Request a Private Showing
          </a>
          {d.externalPhotosUrl && (
            <a href={d.externalPhotosUrl} target="_blank" rel="noopener noreferrer"
              class="bg-white/95 text-[#1e3a5f] px-6 py-3 rounded-lg text-sm font-bold hover:bg-white transition-colors text-center">
              {d.photoCount ? `View All ${d.photoCount} Photos ↗` : 'View All Photos ↗'}
            </a>
          )}
          <a href={`tel:${agent.phone}`}
            class="border-2 border-white/70 text-white px-6 py-3 rounded-lg text-sm font-bold hover:bg-white/10 transition-colors text-center">
            Call {agent.name.split(' ')[0]}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stat Bar -->
  <div class="bg-white border-b border-slate-200 shadow-sm">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4">
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-px bg-slate-200 rounded-lg overflow-hidden">
        {stats.map(stat => (
          <div class="bg-white px-5 py-4">
            <p class="text-xs font-bold uppercase tracking-wider text-slate-400">{stat.label}</p>
            <p class="text-[#1e3a5f] font-extrabold text-lg mt-0.5">{stat.value}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-14 grid md:grid-cols-3 gap-10">

    <!-- Main column -->
    <div class="md:col-span-2 space-y-12">

      {d.highlights.length > 0 && (
        <div class="bg-[#f0f4f8] rounded-xl p-6">
          <h2 class="text-sm font-bold uppercase tracking-widest text-[#c9973a] mb-4">At a Glance</h2>
          <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-2.5">
            {d.highlights.map(item => (
              <li class="flex items-start gap-2.5 text-sm text-slate-700">
                <svg class="w-4 h-4 text-[#c9973a] flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="article-prose">
        <Content />
      </div>

      {d.features.length > 0 && (
        <section>
          <h2 class="text-3xl font-extrabold text-[#1e3a5f] tracking-tight mb-6">Property Features</h2>
          <div class="grid sm:grid-cols-2 gap-4">
            {d.features.map(feature => (
              <div class="card p-5">
                <h3 class="font-bold text-[#1e3a5f] text-base tracking-tight mb-1.5">{feature.title}</h3>
                <p class="text-sm text-slate-600 leading-relaxed">{feature.detail}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      {d.photos.length > 0 && (
        <section>
          <h2 class="text-3xl font-extrabold text-[#1e3a5f] tracking-tight mb-6">Photos</h2>
          <div class="grid sm:grid-cols-2 gap-3">
            {d.photos.map(photo => (
              <img src={photo.src} alt={photo.alt || address} loading="lazy"
                class="w-full h-56 object-cover rounded-xl border border-slate-200" />
            ))}
          </div>
        </section>
      )}

      {d.externalPhotosUrl && (
        <section class="bg-[#1e3a5f] rounded-2xl p-8 md:p-10">
          <span class="text-xs font-bold uppercase tracking-widest text-[#c9973a]">See the full property</span>
          <h2 class="text-2xl md:text-3xl font-extrabold text-white tracking-tight mt-2 mb-3">
            {d.photoCount
              ? `There are ${d.photoCount} listing photos to look through.`
              : 'Browse the full photo set.'}
          </h2>
          <p class="text-white/70 text-sm leading-relaxed max-w-xl mb-6">
            Open the full photo set, then come back here and request a private showing if you want to see
            the property in person.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href={d.externalPhotosUrl} target="_blank" rel="noopener noreferrer"
              class="bg-white text-[#1e3a5f] px-6 py-3 rounded-lg text-sm font-bold hover:bg-slate-100 transition-colors">
              View All Photos ↗
            </a>
            <a href="#inquire"
              class="bg-[#c9973a] text-white px-6 py-3 rounded-lg text-sm font-bold hover:bg-[#b8832e] transition-colors">
              Request a Showing
            </a>
          </div>
        </section>
      )}

      <!-- Inquiry Form -->
      <section id="inquire" class="card p-6 md:p-8 scroll-mt-24">
        <span class="eyebrow">Get more information</span>
        <h2 class="text-3xl font-extrabold text-[#1e3a5f] tracking-tight mt-1 mb-2">Want to see this home?</h2>
        <p class="text-slate-500 text-sm mb-7">
          Send your information below and {agent.name} will follow up — usually the same day.
        </p>

        <form
          name="listing-inquiry"
          method="POST"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          class="space-y-5"
        >
          <input type="hidden" name="form-name" value="listing-inquiry" />
          <input type="hidden" name="property" value={address} />
          <input type="hidden" name="mls" value={d.mls || ''} />
          <p class="hidden">
            <label>Don't fill this out: <input name="bot-field" /></label>
          </p>

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="lead-name" class="block text-sm font-semibold text-slate-700 mb-1.5">
                Your Name <span class="text-red-400" aria-hidden="true">*</span>
              </label>
              <input type="text" id="lead-name" name="name" required autocomplete="name"
                class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#1e3a5f] focus:border-transparent transition-all bg-white placeholder-slate-300"
                placeholder="Jane Smith" />
            </div>
            <div>
              <label for="lead-phone" class="block text-sm font-semibold text-slate-700 mb-1.5">
                Phone <span class="text-red-400" aria-hidden="true">*</span>
              </label>
              <input type="tel" id="lead-phone" name="phone" required autocomplete="tel"
                class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#1e3a5f] focus:border-transparent transition-all bg-white placeholder-slate-300"
                placeholder="(218) 555-0100" />
            </div>
          </div>

          <div>
            <label for="lead-email" class="block text-sm font-semibold text-slate-700 mb-1.5">
              Email <span class="text-red-400" aria-hidden="true">*</span>
            </label>
            <input type="email" id="lead-email" name="email" required autocomplete="email"
              class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#1e3a5f] focus:border-transparent transition-all bg-white placeholder-slate-300"
              placeholder="jane@example.com" />
          </div>

          <div>
            <label for="lead-interest" class="block text-sm font-semibold text-slate-700 mb-1.5">What are you interested in?</label>
            <select id="lead-interest" name="interest"
              class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#1e3a5f] focus:border-transparent transition-all bg-white">
              <option>Schedule a private showing</option>
              <option>Ask a question about the property</option>
              <option>Get financing information</option>
              <option>Make an offer</option>
            </select>
          </div>

          <div>
            <label for="lead-message" class="block text-sm font-semibold text-slate-700 mb-1.5">Message</label>
            <textarea id="lead-message" name="message" rows="4"
              class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#1e3a5f] focus:border-transparent transition-all bg-white placeholder-slate-300 resize-none"
              placeholder="What would you like to know?"></textarea>
          </div>

          <button type="submit"
            class="w-full bg-[#1e3a5f] text-white py-3.5 rounded-xl font-semibold hover:bg-[#2d5480] transition-all duration-200 text-sm">
            Send My Request
          </button>

          <p class="text-xs text-slate-400 leading-relaxed">
            By submitting, you agree that {agent.name} may contact you about this property. No automated
            marketing consent is required to send this form.
          </p>
        </form>
      </section>
    </div>

    <!-- Sidebar -->
    <aside class="space-y-5">

      <!-- Agent Card -->
      <div class="bg-[#1e3a5f] rounded-xl p-6 text-white md:sticky md:top-24">
        <p class="text-xs font-bold uppercase tracking-widest text-[#c9973a] mb-3">Listing Agent</p>
        <div class="flex gap-3 items-center mb-4">
          <div class="w-14 h-14 rounded-full bg-white/10 flex-shrink-0 overflow-hidden">
            <img src={agent.image} alt={agent.name} class="w-full h-full object-cover" />
          </div>
          <div>
            <a href={`/agents/${agent.slug}`} class="font-bold text-white hover:text-[#c9973a] transition-colors block">{agent.name}</a>
            <p class="text-xs text-white/60">{agent.title} · {agent.brokerage}</p>
          </div>
        </div>
        <p class="text-sm text-white/70 leading-relaxed mb-5">
          Questions about the property, financing or availability? Reach out directly, or send the form
          and I'll follow up.
        </p>
        <div class="space-y-2">
          <a href={`tel:${agent.phone}`}
            class="block bg-[#c9973a] text-white text-center px-4 py-3 rounded-lg text-sm font-bold hover:bg-[#b8832e] transition-colors">
            Call {agent.phone}
          </a>
          <a href={`sms:${agent.phone.replace(/[^0-9]/g, '')}`}
            class="block bg-white/10 text-white text-center px-4 py-3 rounded-lg text-sm font-bold hover:bg-white/20 transition-colors">
            Text {agent.name.split(' ')[0]}
          </a>
          <a href={`mailto:${agent.email}?subject=${emailSubject}`}
            class="block bg-white/10 text-white text-center px-4 py-3 rounded-lg text-sm font-bold hover:bg-white/20 transition-colors">
            Email {agent.name.split(' ')[0]}
          </a>
        </div>
      </div>

      <!-- Key Facts -->
      <div class="card p-6">
        <h3 class="font-extrabold text-[#1e3a5f] text-base tracking-tight mb-4">Property Details</h3>
        <dl class="divide-y divide-slate-100">
          {facts.map(fact => (
            <div class="flex justify-between gap-4 py-2.5">
              <dt class="text-sm text-slate-500">{fact.label}</dt>
              <dd class="text-sm font-semibold text-[#1e3a5f] text-right">{fact.value}</dd>
            </div>
          ))}
          <div class="flex justify-between gap-4 py-2.5">
            <dt class="text-sm text-slate-500">Status</dt>
            <dd class="text-sm font-semibold text-[#1e3a5f] text-right">{status.label}</dd>
          </div>
        </dl>
        {d.mapQuery && (
          <a href={mapUrl(d.mapQuery)} target="_blank" rel="noopener noreferrer"
            class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-[#2d5480] hover:text-[#c9973a] transition-colors">
            View on Google Maps ↗
          </a>
        )}
      </div>

      <!-- Local context -->
      <div class="bg-[#f5f0e8] rounded-xl p-6">
        <h3 class="font-extrabold text-[#1e3a5f] text-base tracking-tight mb-2">New to the area?</h3>
        <p class="text-sm text-slate-600 leading-relaxed mb-4">
          {d.city} sits in {d.county ? `${d.county} County` : 'northern Minnesota'}, close to lakes,
          forest and small-town amenities. Here's what to know before you buy.
        </p>
        <ul class="space-y-2">
          <li><a href="/lakes" class="text-sm font-semibold text-[#2d5480] hover:text-[#c9973a] transition-colors">Lakes &amp; lakefront guide →</a></li>
          <li><a href="/guides" class="text-sm font-semibold text-[#2d5480] hover:text-[#c9973a] transition-colors">Buyer's guide step by step →</a></li>
          <li><a href="/blog" class="text-sm font-semibold text-[#2d5480] hover:text-[#c9973a] transition-colors">Northern MN market insights →</a></li>
        </ul>
      </div>
    </aside>
  </div>

  <!-- Disclosure -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 pb-4">
    <p class="text-xs text-slate-400 leading-relaxed border-t border-slate-200 pt-6">
      Listing information is believed accurate but is not guaranteed. Buyers should independently verify
      all property details, including square footage, acreage, taxes, well and septic, and zoning.
      {d.mls && ` MLS #${d.mls}.`} Listed by {agent.name}, {agent.license}, {BROKERAGE.name}.
      Equal Housing Opportunity.
    </p>
  </div>
</Layout>
